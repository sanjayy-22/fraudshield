# Server-side only. Copy to .env and supply your own credential locally.
# Never put this key in VITE_* variables or commit .env.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.8-27b:free
FRAUDSHIELD_LLM=1
# Use a long random alphanumeric password here; change the local-only default before deployment.
POSTGRES_DB=fraudshield
POSTGRES_USER=fraudshield
POSTGRES_PASSWORD=replace-with-long-random-alphanumeric-password
PORTAL_PORT=5174
# Razorpay checkout credentials: keep both values server-side.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Amazon SES SMTP (create SES SMTP credentials; do not use AWS console login keys).
SES_SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SES_SMTP_PORT=587
SES_SMTP_USERNAME=
SES_SMTP_PASSWORD=
SES_FROM_EMAIL=
# Admin creation is invite-only; choose a long random value and share it out-of-band.
FRAUDSHIELD_ADMIN_INVITE_CODE=
