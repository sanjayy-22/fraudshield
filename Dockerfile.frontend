FROM node:22-alpine AS build
WORKDIR /app
COPY frontend/portal/package.json frontend/portal/package-lock.json ./
RUN npm ci
COPY frontend/portal/ ./
ARG VITE_PORTAL_API_URL=/portal-api
ENV VITE_PORTAL_API_URL=${VITE_PORTAL_API_URL}
RUN npm run build

FROM nginx:1.27-alpine
COPY frontend/portal/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=20s --timeout=3s --retries=3 CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1
